# API Security
API_KEY=change-me-to-a-secure-random-string

# LLM Model (GGUF via llama-cpp-python)
MODEL_PATH=models/qwen2.5-7b-instruct-q4_k_m.gguf
MODEL_N_CTX=4096
MODEL_N_GPU_LAYERS=0
MODEL_MAX_TOKENS=1024
MODEL_TEMPERATURE=0.1

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:password@localhost:5432/docqa_ai

# Storage
DATA_DIR=data
UPLOAD_DIR=uploads

# Server
HOST=0.0.0.0
PORT=8000
